# Habitica API Credentials
HABITICA_USER_ID=your_habitica_user_id
HABITICA_API_KEY=your_habitica_api_key
HABITICA_BASE_URL=https://habitica.com/api/v3

# Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth by Neon)
NEON_AUTH_URL=https://ep-xyz.neoauth.c-4.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xyz.neoauth.c-4.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-xyz.neoauth.c-4.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
BETTER_AUTH_SECRET=generate_a_random_32_char_secret_key
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar Private iCal URL
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics
