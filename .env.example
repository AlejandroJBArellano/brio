# Brio - Environment Configuration Template
# Copy this file to .env.local and fill in your Habitica credentials

# Find your User ID and API Token in Habitica:
# Settings -> API -> User ID & API Token
HABITICA_USER_ID=your_habitica_user_id_here
HABITICA_API_KEY=your_habitica_api_token_here

# Habitica API Base URL (defaults to official v3 endpoint)
HABITICA_BASE_URL=https://habitica.com/api/v3
